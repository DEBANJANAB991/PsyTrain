# Copy to .env (never commit .env). Key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_xxx
# Filled in automatically by `npm run agent` on first run
ELEVENLABS_AGENT_ID=
# Optional: voice ID from "My Voices" in your account (default: Jessica, female)
# Other female voices: Laura FGY2WhTYpPnrIDTdsKH5 (quirky), Sarah EXAVITQu4vr4xnSDxMaL (calm), Bella hpp4J3VqNfWAUOO0d1Us (warm)
ELEVENLABS_VOICE_ID=
