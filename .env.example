# Copy to .env and fill in. .env is git-ignored; the key stays on the server and never reaches the browser.
# Restart `npm run dev` after editing.

# https://elevenlabs.io -> profile -> API keys
ELEVENLABS_API_KEY=

# Optional. Default is the premade voice "Sarah". Copy another voice id from the ElevenLabs voice library.
ELEVENLABS_VOICE_ID=

# Optional. eleven_flash_v2_5 (fast, cheap, default) or eleven_multilingual_v2 (higher quality).
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional. The ElevenLabs patient agent for live conversations. Default: AGENT_ID from ai-patient-voice/.env,
# which ai-patient-voice/create_agent.py writes.
ELEVENLABS_AGENT_ID=

# --- Director agent (natural-language control of the patient's personality and body language) ---
# Without credentials for either provider the director falls back to simple offline rules.
# Optional. "bedrock" or "anthropic". Default: bedrock when AWS credentials are set, otherwise anthropic.
AGENT_PROVIDER=
# Option 1: Claude in Amazon Bedrock. Temporary (STS) credentials need AWS_SESSION_TOKEN and expire;
# AWS_BEARER_TOKEN_BEDROCK or AWS_PROFILE also work instead of the key pair.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional. Default anthropic.claude-opus-5-5 (bedrock-mantle endpoint; needs model access in the Bedrock console).
# Ids with an inference-profile prefix or version go to the bedrock-runtime endpoint instead,
# e.g. global.anthropic.claude-sonnet-4-6 or global.anthropic.claude-haiku-4-5-20251001-v1:0.
BEDROCK_MODEL=
# Optional. Model used when the main model declines a request. Default anthropic.claude-opus-4-8.
BEDROCK_FALLBACK_MODEL=
# --- Orchestrator (server/orchestrator.js: writes the voice patient's answers, normal / distracted modes) ---
# Optional. Model for her words. Default: BEDROCK_MODEL (Bedrock) or claude-sonnet-4-6 (Claude API).
PATIENT_MODEL=
# Optional. Fast model for the mode decisions and the memory summary.
# Default: global.anthropic.claude-haiku-4-5-20251001-v1:0 (Bedrock) or claude-haiku-4-5 (Claude API).
ORCHESTRATOR_MODEL=
# Option 2: the Claude API. https://console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
# Optional. Default claude-opus-5-5.
ANTHROPIC_MODEL=
# Optional. Set to "off" to disable the automatic safety-refusal fallback model.
ANTHROPIC_FALLBACKS=
