# Copy to .env and fill in. .env is git-ignored; the key stays on the server and never reaches the browser.
# Restart `npm run dev` after editing.

# https://elevenlabs.io -> profile -> API keys
ELEVENLABS_API_KEY=

# Optional. Default is the premade voice "Sarah". Copy another voice id from the ElevenLabs voice library.
ELEVENLABS_VOICE_ID=

# Optional. eleven_flash_v2_5 (fast, cheap, default) or eleven_multilingual_v2 (higher quality).
ELEVENLABS_MODEL=eleven_flash_v2_5
