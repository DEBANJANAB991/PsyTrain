# Copy to .env and add your ElevenLabs API key. Never commit .env.
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here
# Mary (the agent the 3D app uses)
AGENT_ID=
# Orchestrator link for Mary (written by update_agent.py / create_agent.py). ORCHESTRATOR_URL is optional:
# without it the running Cloudflare quick tunnel is used.
ORCHESTRATOR_TOKEN=
ORCHESTRATOR_URL=
# Other patients, filled in by: python create_agent.py --patient <ryan|sophie|tom>
AGENT_ID_RYAN=
AGENT_ID_SOPHIE=
AGENT_ID_TOM=
